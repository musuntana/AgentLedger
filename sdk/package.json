{
  "name": "@agentledger/verify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ledger read-only Monad Testnet verification SDK",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "packcheck": "npm run build && node scripts/packcheck.mjs",
    "typecheck": "npm run build && npx tsc --project test/tsconfig.json",
    "prepack": "npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "viem": "2.57.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "~6.0.3"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musuntana/monad-hackathon.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/musuntana/monad-hackathon/issues"
  },
  "homepage": "https://github.com/musuntana/monad-hackathon/tree/master/sdk"
}
